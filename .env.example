# --- Supabase ---
# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=
# Chave "service_role" do Supabase (Project Settings > API > Project API keys)
# NUNCA exponha esta chave no client. Ela só é usada dentro da API route (servidor).
SUPABASE_SERVICE_ROLE_KEY=

# Se as duas variáveis acima não estiverem preenchidas, o formulário de lista de
# espera continua funcionando: ele só grava os dados no console do servidor
# (modo desenvolvimento), sem quebrar a página.

# --- Site ---
# URL pública do site, usada em metadados (Open Graph, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://meuinvestidor.com.br

# --- Analytics (opcional) ---
# Preencha para habilitar o Meta Pixel. Um evento "Lead" é disparado quando
# alguém entra na lista de espera com sucesso.
NEXT_PUBLIC_META_PIXEL_ID=

# Preencha para habilitar o Google Analytics 4 (Measurement ID, ex: G-XXXXXXX).
# Um evento "generate_lead" é disparado quando alguém entra na lista de espera.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
